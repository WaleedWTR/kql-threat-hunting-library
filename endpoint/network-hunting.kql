// Hunt: script interpreters making outbound connections
DeviceNetworkEvents
| where Timestamp > ago(24h)
| where InitiatingProcessFileName in~ ("powershell.exe", "pwsh.exe", "wscript.exe", "cscript.exe", "mshta.exe")
| summarize Connections=count(),
    Destinations=make_set(RemoteUrl, 25),
    RemoteIPs=make_set(RemoteIP, 25)
    by DeviceName, InitiatingProcessAccountName, InitiatingProcessFileName
| order by Connections desc;

// Hunt: rare remote ports
DeviceNetworkEvents
| where Timestamp > ago(7d)
| summarize Connections=count(), Devices=dcount(DeviceName) by RemotePort
| where Connections < 5
| order by Connections asc;
